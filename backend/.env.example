# Safe local demo defaults. Copy to .env and keep .env out of Git.
EMAIL_MOCK=true
LLM_PROVIDER=mock

# Optional real email configuration; unused while EMAIL_MOCK=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=demo@example.com
SMTP_PASS=
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=demo@example.com
IMAP_PASS=

# Optional model configuration: set LLM_PROVIDER=deepseek to enable.
DEEPSEEK_API_KEY=
